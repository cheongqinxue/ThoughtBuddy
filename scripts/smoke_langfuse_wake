#!/usr/bin/env bash
# Enable Langfuse credentials and run a wake smoke test without leaving traces behind.
#
# Usage:
#   ./scripts/smoke_langfuse_wake

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LANGFUSE_DIR="${THOUGHTBUDDY_LANGFUSE_DIR:-${ROOT}/.data/langfuse-docker}"
ENV_FILE="${LANGFUSE_DIR}/.env"
LANGFUSE_HOST_PORT="${LANGFUSE_HOST_PORT:-3001}"
UI_URL="${LANGFUSE_UI_URL:-http://localhost:${LANGFUSE_HOST_PORT}}"
START_SCRIPT="${ROOT}/scripts/start_langfuse"
SYNC_SCRIPT="${ROOT}/scripts/sync_langfuse_env.py"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    exit 1
  fi
}

langfuse_healthy() {
  curl --silent --fail --max-time 5 "${UI_URL}/api/public/health" >/dev/null 2>&1
}

wait_for_langfuse() {
  echo "Waiting for Langfuse at ${UI_URL}..."
  local attempt=0
  local max_attempts=90
  while (( attempt < max_attempts )); do
    if langfuse_healthy; then
      echo "Langfuse is healthy."
      return
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  echo "error: Langfuse did not become healthy within $((max_attempts * 2)) seconds" >&2
  exit 1
}

main() {
  require_command curl

  if ! langfuse_healthy; then
    echo "Starting Langfuse..."
    "${START_SCRIPT}" --detach
    wait_for_langfuse
  else
    echo "Langfuse already running at ${UI_URL}"
  fi

  echo "Syncing Langfuse credentials into ${ROOT}/.env..."
  uv run python "${SYNC_SCRIPT}" --base-url "${UI_URL}"

  echo "Running wake smoke test (trace deletion is queued afterward)..."
  cd "${ROOT}"
  THOUGHTBUDDY_LANGFUSE_SMOKE=1 uv run pytest tests/test_langfuse_integration.py::TestLangfuseLiveIntegration::test_wake_invoke_creates_queryable_trace_and_cleans_up -m integration -v

  cat <<EOF

Langfuse wake smoke test passed.

Runtime is configured for tracing:
  config.yaml: observability.langfuse.enabled=true
  .env:        LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL

Restart the dev server to pick up credentials:
  uv run langgraph dev

Langfuse UI: ${UI_URL}

EOF
}

main "$@"
