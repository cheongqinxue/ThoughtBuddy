#! /bin/bash
# Legacy Nemotron serve script. Nemotron narrates instead of tool-calling with vLLM
# 0.24 + pythonic parser — not suitable for the ThoughtBuddy harness.
# Prefer: ./scripts/start_vllm_agent.sh (Qwen2.5 + hermes)

set -e

VLLM="${HOME}/anaconda3/envs/llm/bin/vllm"
PYTHON="${HOME}/anaconda3/envs/llm/bin/python"
MODEL="cyankiwi/NVIDIA-Nemotron-Nano-9B-v2-AWQ-4bit"

# shellcheck source=/dev/null
source "$(dirname "$0")/_vllm_cuda_env.sh"

"${VLLM}" serve "${MODEL}" \
  --trust-remote-code \
  --enable-auto-tool-choice \
  --tool-call-parser pythonic