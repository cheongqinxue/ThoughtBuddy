#!/usr/bin/env bash
# Start self-hosted Langfuse locally via the upstream docker-compose stack.
#
# Usage:
#   ./scripts/start_langfuse            # foreground (Ctrl+C to stop)
#   ./scripts/start_langfuse --detach   # background
#   ./scripts/start_langfuse stop       # stop containers
#   ./scripts/start_langfuse logs       # follow logs (detached mode)
#
# UI: http://localhost:3001  (3000 is often used by Open WebUI)
# ThoughtBuddy: set observability.langfuse.enabled=true and copy API keys from
#   .data/langfuse-docker/.env into your project .env

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LANGFUSE_DIR="${THOUGHTBUDDY_LANGFUSE_DIR:-${ROOT}/.data/langfuse-docker}"
LANGFUSE_REPO="${THOUGHTBUDDY_LANGFUSE_REPO:-https://github.com/langfuse/langfuse.git}"
LANGFUSE_REF="${THOUGHTBUDDY_LANGFUSE_REF:-main}"
ENV_FILE="${LANGFUSE_DIR}/.env"
OVERRIDE_FILE="${LANGFUSE_DIR}/docker-compose.override.yml"
LANGFUSE_HOST_PORT="${LANGFUSE_HOST_PORT:-3001}"
UI_URL="${LANGFUSE_UI_URL:-http://localhost:${LANGFUSE_HOST_PORT}}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  up            Start Langfuse (default)
  stop          Stop containers
  logs          Follow container logs
  pull          Refresh upstream compose file and Docker images

Options:
  -d, --detach  Run containers in the background (up only)
  -h, --help    Show this help

Environment:
  THOUGHTBUDDY_LANGFUSE_DIR   Clone/workdir (default: .data/langfuse-docker)
  THOUGHTBUDDY_LANGFUSE_REPO  Git repository URL
  THOUGHTBUDDY_LANGFUSE_REF   Git branch or tag (default: main)
  LANGFUSE_HOST_PORT          Host port for Langfuse UI (default: 3001)
  LANGFUSE_UI_URL             Full UI URL override (default: http://localhost:\$LANGFUSE_HOST_PORT)
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    exit 1
  fi
}

compose() {
  docker compose --project-directory "${LANGFUSE_DIR}" "$@"
}

ensure_docker() {
  require_command docker
  if ! docker compose version >/dev/null 2>&1; then
    echo "error: docker compose plugin is required" >&2
    exit 1
  fi
}

ensure_upstream() {
  if [[ -d "${LANGFUSE_DIR}/.git" ]]; then
    return
  fi

  require_command git
  mkdir -p "$(dirname "${LANGFUSE_DIR}")"
  echo "Cloning Langfuse (${LANGFUSE_REF}) into ${LANGFUSE_DIR}..."
  git clone --depth 1 --branch "${LANGFUSE_REF}" "${LANGFUSE_REPO}" "${LANGFUSE_DIR}"
}

refresh_upstream() {
  ensure_upstream
  require_command git
  echo "Updating Langfuse checkout in ${LANGFUSE_DIR}..."
  git -C "${LANGFUSE_DIR}" fetch origin "${LANGFUSE_REF}" --depth 1
  git -C "${LANGFUSE_DIR}" checkout "${LANGFUSE_REF}"
  git -C "${LANGFUSE_DIR}" pull --ff-only origin "${LANGFUSE_REF}" || true
}

rand_hex() {
  openssl rand -hex "$1"
}

ensure_compose_override() {
  cat >"${OVERRIDE_FILE}" <<EOF
# Generated by scripts/start_langfuse — avoids port 3000 conflicts (e.g. Open WebUI).
services:
  langfuse-web:
    ports: !override
      - "${LANGFUSE_HOST_PORT}:3000"
    environment:
      NEXTAUTH_URL: ${UI_URL}
      LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT: http://localhost:9090
EOF
}

sync_env_url() {
  if [[ ! -f "${ENV_FILE}" ]]; then
    return
  fi

  if grep -q '^NEXTAUTH_URL=' "${ENV_FILE}"; then
    sed -i "s|^NEXTAUTH_URL=.*|NEXTAUTH_URL=${UI_URL}|" "${ENV_FILE}"
  else
    echo "NEXTAUTH_URL=${UI_URL}" >>"${ENV_FILE}"
  fi
}

ensure_env_file() {
  if [[ -f "${ENV_FILE}" ]]; then
    return
  fi

  require_command openssl

  local encryption_key nextauth_secret salt redis_auth postgres_password
  local minio_password clickhouse_password
  local init_public_key init_secret_key init_password

  encryption_key="$(rand_hex 32)"
  nextauth_secret="$(rand_hex 32)"
  salt="$(rand_hex 16)"
  redis_auth="$(rand_hex 16)"
  postgres_password="$(rand_hex 16)"
  minio_password="$(rand_hex 16)"
  clickhouse_password="$(rand_hex 16)"
  init_public_key="pk-lf-$(rand_hex 16)"
  init_secret_key="sk-lf-$(rand_hex 16)"
  init_password="$(rand_hex 12)"

  cat >"${ENV_FILE}" <<EOF
# Generated by scripts/start_langfuse on first run.
# Local development only — do not reuse in production.

NEXTAUTH_URL=${UI_URL}
NEXTAUTH_SECRET=${nextauth_secret}
SALT=${salt}
ENCRYPTION_KEY=${encryption_key}
TELEMETRY_ENABLED=false

POSTGRES_PASSWORD=${postgres_password}
DATABASE_URL=postgresql://postgres:${postgres_password}@postgres:5432/postgres

REDIS_AUTH=${redis_auth}
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=${minio_password}
CLICKHOUSE_PASSWORD=${clickhouse_password}

# Keep Langfuse S3/MinIO credentials aligned (defaults in upstream compose use miniosecret).
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${minio_password}
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${minio_password}
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${minio_password}

# Headless bootstrap: first admin user + ThoughtBuddy project keys.
# LANGFUSE_INIT_ORG_ID is required in v4 or other LANGFUSE_INIT_* vars are ignored.
LANGFUSE_INIT_ORG_ID=thoughtbuddy-local
LANGFUSE_INIT_ORG_NAME="ThoughtBuddy Local"
LANGFUSE_INIT_PROJECT_ID=thoughtbuddy
LANGFUSE_INIT_PROJECT_NAME=thoughtbuddy
LANGFUSE_INIT_USER_EMAIL=admin@thoughtbuddy.local
LANGFUSE_INIT_USER_NAME="ThoughtBuddy Admin"
LANGFUSE_INIT_USER_PASSWORD=${init_password}
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=${init_public_key}
LANGFUSE_INIT_PROJECT_SECRET_KEY=${init_secret_key}
EOF

  chmod 600 "${ENV_FILE}"

  cat <<EOF
Created ${ENV_FILE}

Langfuse UI:     ${UI_URL}
Admin login:     admin@thoughtbuddy.local / ${init_password}

Add these to ThoughtBuddy .env:
  LANGFUSE_PUBLIC_KEY=${init_public_key}
  LANGFUSE_SECRET_KEY=${init_secret_key}
  LANGFUSE_BASE_URL=${UI_URL}

And enable tracing in config.yaml:
  observability:
    langfuse:
      enabled: true

EOF
}

print_ready_hint() {
  cat <<EOF
Starting Langfuse...
UI will be available at ${UI_URL} once langfuse-web logs "Ready" (usually 2-3 minutes).

EOF
}

cmd_up() {
  local detach=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d | --detach)
        detach=true
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        echo "error: unknown option for up: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  ensure_docker
  ensure_upstream
  ensure_compose_override
  ensure_env_file
  sync_env_url
  print_ready_hint

  if [[ "${detach}" == true ]]; then
    compose up --detach --pull missing
    echo "Langfuse is running in the background."
    echo "Follow logs: $(basename "$0") logs"
    echo "Stop:        $(basename "$0") stop"
  else
    compose up --pull missing
  fi
}

cmd_stop() {
  ensure_docker
  ensure_upstream
  compose down
}

cmd_logs() {
  ensure_docker
  ensure_upstream
  compose logs --follow
}

cmd_pull() {
  ensure_docker
  refresh_upstream
  compose pull
}

main() {
  local command="up"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    command="$1"
    shift
  fi

  case "${command}" in
    up | start)
      cmd_up "$@"
      ;;
    stop | down)
      cmd_stop
      ;;
    logs)
      cmd_logs
      ;;
    pull | update)
      cmd_pull
      ;;
    -h | --help | help)
      usage
      ;;
    *)
      echo "error: unknown command: ${command}" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
