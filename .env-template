# API keys and secrets only.
# Non-sensitive settings live in config.yaml — see docs/CONFIG.md.

# OpenAI-compatible inference server API key (use EMPTY for local vLLM)
OPENAI_API_KEY=EMPTY

# LangSearch API key for the agent websearch tool
LANGSEARCH_API_KEY=

# Shared secret for event/callback ingress (POST /thoughtbuddy/tasks/event)
EVENT_WEBHOOK_SECRET=

# LangSmith API key (read by `langgraph dev` — not loaded into Settings)
LANGSMITH_API_KEY=

# Langfuse tracing (optional — enable observability.langfuse.enabled in config.yaml)
# Local self-host: ./scripts/start_langfuse --detach (prints keys on first run)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3001
